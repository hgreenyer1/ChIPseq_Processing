#!/usr/bin/env bash
# =============================================================================
# ChIP-seq pipeline configuration
#
# This file is sourced (as bash) by submit_chipseq.sh and by every job. A copy
# is saved to <outdir>/pipeline_info/ at submission and the jobs read that
# copy, so editing this file never changes a run that is already queued.
#
# Copy it and pass your copy with `submit_chipseq.sh -c my.config` to keep
# per-project settings separate.
# =============================================================================

# -----------------------------------------------------------------------------
# Software environment
# Runs at the start of every job. Load modules / activate conda here.
# -----------------------------------------------------------------------------
setup_env() {
    # module load samtools bowtie2 ...
    # source "$HOME/miniconda3/etc/profile.d/conda.sh"
    # conda activate chipseq
    :
}

# -----------------------------------------------------------------------------
# Reference genome (defaults: hg38 on the VACC)
# -----------------------------------------------------------------------------
GENOME_NAME="hg38"
# bowtie2 index prefix (the path without the .1.bt2 suffix)
BOWTIE2_INDEX="/users/h/g/hgreenye/INDEXES/HG38/BOWTIE_INDEX/GRCh38_noalt_as/GRCh38_noalt_as"
# two-column chrom<TAB>length file matching the index
CHROM_SIZES="/users/h/g/hgreenye/INDEXES/HG38/BOWTIE_INDEX/GRCh38_noalt_as/hg38NameLength.txt"
# ENCODE blacklist (https://github.com/Boyle-Lab/Blacklist/tree/master/lists)
# Leave empty to skip blacklist filtering of peaks.
BLACKLIST="/users/h/g/hgreenye/INDEXES/HG38/hg38-blacklist.v2.bed"
# MACS2 genome size shortcut (hs, mm, ce, dm) or a number
MACS_GSIZE="hs"
# Effective genome size for deepTools (hg38 = 2913022398, mm10 = 2652783500)
EFFECTIVE_GENOME_SIZE=2913022398

# -----------------------------------------------------------------------------
# SLURM
# -----------------------------------------------------------------------------
SLURM_PARTITION="bluemoon"
SLURM_ACCOUNT=""        # --account, leave empty if not needed
SLURM_QOS=""            # --qos, leave empty if not needed
# Any extra sbatch options, applied to every job, e.g.
#   SLURM_EXTRA_ARGS=(--mail-user=you@uvm.edu --mail-type=FAIL)
SLURM_EXTRA_ARGS=()
# Prefix for job names (shows up in squeue)
JOB_PREFIX="chip"

# Resources per step: CPUS / MEM / TIME
TRIM_CPUS=4;       TRIM_MEM="8G";       TRIM_TIME="06:00:00"
ALIGN_CPUS=12;     ALIGN_MEM="24G";     ALIGN_TIME="24:00:00"
FILTER_CPUS=4;     FILTER_MEM="24G";    FILTER_TIME="12:00:00"
BAMQC_CPUS=8;      BAMQC_MEM="24G";     BAMQC_TIME="12:00:00"
PEAKS_CPUS=4;      PEAKS_MEM="24G";     PEAKS_TIME="12:00:00"
REPRO_CPUS=4;      REPRO_MEM="32G";     REPRO_TIME="30:00:00"
CONSENSUS_CPUS=8;  CONSENSUS_MEM="16G"; CONSENSUS_TIME="06:00:00"
MULTIQC_CPUS=1;    MULTIQC_MEM="8G";    MULTIQC_TIME="02:00:00"

# -----------------------------------------------------------------------------
# Trimming / alignment
# -----------------------------------------------------------------------------
TRIM_GALORE_ARGS=""        # e.g. "--nextseq 20" for 2-colour chemistry
BOWTIE2_ARGS=""            # extra bowtie2 options, e.g. "--very-sensitive"
MAX_FRAGMENT_LENGTH=2000   # bowtie2 -X for paired-end (ENCODE uses 2000)

# -----------------------------------------------------------------------------
# BAM filtering (ENCODE)
# -----------------------------------------------------------------------------
MAPQ_THRESHOLD=30          # ENCODE: 30
KEEP_DUPLICATES="false"    # true keeps PCR duplicates (still marked)
FILTER_CHRS=""             # space separated chromosomes to drop, e.g. "chrM"
PICARD_CMD="picard"        # or "java -jar /path/to/picard.jar"

# -----------------------------------------------------------------------------
# Library QC
# -----------------------------------------------------------------------------
RUN_SPP="true"             # phantompeakqualtools NSC/RSC + fragment length
SPP_NREADS=15000000        # reads subsampled for cross-correlation (ENCODE)
DEFAULT_FRAGLEN=200        # single-end fallback when SPP is off or fails
MIN_FRAGLEN=50             # SPP estimates below this are ignored
BIGWIG_BINSIZE=10
BIGWIG_NORM="CPM"          # bamCoverage --normalizeUsing (CPM, RPKM, BPM, RPGC)
RUN_FINGERPRINT="true"     # deepTools plotFingerprint of IP vs control
FINGERPRINT_SAMPLES=500000   # bins sampled by plotFingerprint

# -----------------------------------------------------------------------------
# Peak calling
# -----------------------------------------------------------------------------
# Used when the samplesheet has no peak_type column / value (narrow|broad).
# Rule of thumb: TFs and H3K4me3/H3K27ac/H3K9ac = narrow;
#                H3K27me3/H3K36me3/H3K9me3/H3K79me2/H3K4me1 = broad.
PEAK_TYPE_DEFAULT="narrow"
# macs2 or macs3 (same arguments). Current conda builds of macs2 2.2.9.1 fail on
# newer systems (glibc >= 2.31, "undefined symbol: __log_finite"), so the
# conda environment ships macs3. Output folders are called macs2/ either way.
MACS_CMD="macs3"
MACS_QVAL=0.05             # q-value for the main narrowPeak call (nf-core)
MACS_BROAD_CUTOFF=0.1      # --broad-cutoff for the main broadPeak call (nf-core)
MACS_EXTRA_ARGS=""         # extra args added to every MACS2 call
# Relaxed calls feeding IDR / overlap analysis and signal tracks (ENCODE)
RELAXED_PVAL=0.01
RELAXED_NPEAKS=500000

# -----------------------------------------------------------------------------
# Replicate reproducibility (ENCODE)
# -----------------------------------------------------------------------------
RUN_REPRODUCIBILITY="true"
# auto = IDR for narrow samples, naive overlap for broad samples
REPRO_METHOD="auto"        # auto | idr | overlap
IDR_THRESHOLD=0.05
IDR_RANK="p.value"         # ENCODE uses p.value for MACS2 peaks
PSEUDOREP_SEED=42
# Leave empty to run the idr found on PATH through a numpy compatibility shim
# (idr 2.0.4.2 breaks with numpy >= 1.24). Set to e.g. a separate env's
# "/path/to/envs/idr/bin/idr" to run that binary directly instead.
IDR_CMD=""

# -----------------------------------------------------------------------------
# Consensus peaks / counts per antibody (nf-core)
# -----------------------------------------------------------------------------
RUN_CONSENSUS="true"
CONSENSUS_MIN_LIBS=1       # keep merged peaks found in >= this many libraries

# -----------------------------------------------------------------------------
# Housekeeping
# -----------------------------------------------------------------------------
# Delete trimmed FASTQs and per-lane BAMs once they are no longer needed
CLEAN_INTERMEDIATES="true"
